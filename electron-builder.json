{
  "appId": "dev.abdelrahman-eltokhy.pharma-ledger",
  "files": ["dist-electron", "dist-react"],
  "icon": "./assets/pharma-ledger-icon.ico",
  "extraResources": ["dist-electron/electron/preload.cjs"],
  "mac": {
    "target": ["dmg"]
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Utility"
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Pharma Ledger"
  }
}
